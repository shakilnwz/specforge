#!/usr/bin/env bash
#
# check — the rule checks that hold whoever made the change: any coding agent, or a person.
# Run it in CI, and optionally in a pre-commit hook:  .ai/bin/check
#
#   sync      every agent's generated rule files, and .ai/rules/index.md, match .ai/rules/
#   markers   after Phase 0, no <!-- bootstrap: … --> placeholder remains
#   trace     every requirement of an Implemented spec is cited by a test tag (NNNN.Rn)
#   budgets   AGENTS.md fits Codex's 32 KiB; each Antigravity rule fits its 24,000 bytes
#   incoming  warns, without failing, while a <file>.specforge-incoming awaits reconciliation
#
# The stack's own gates — lint, format, type check, tests, arch tests — run beside it in CI.
# Exit 0 when every check holds, 1 when any fails; a warning never fails.
# Portable: bash 3.2 or later and POSIX awk, sed, grep, find. No git, no network.

set -u
export LC_ALL=C

failures=0

fail() {
    printf 'FAIL  %s\n' "$1"
    failures=$((failures + 1))
}

pass() {
    printf 'ok    %s\n' "$1"
}

note() {
    printf 'warn  %s\n' "$1"
}

check_sync() {
    if output=$("$root/.ai/bin/sync-rules" --check 2>&1); then
        pass 'agent rule files and .ai/rules/index.md match .ai/rules/'
    else
        printf '%s\n' "$output" | sed 's/^/      /'
        fail 'agent rule files out of sync — run .ai/bin/sync-rules'
    fi
}

check_markers() {
    phase=$(sed -n 's/^\*\*Phase \([0-9][0-9]*\).*/\1/p' AGENTS.md 2>/dev/null | sed -n 1p)
    if [ -z "$phase" ] || [ "$phase" = 0 ]; then
        pass "placeholders allowed during Phase ${phase:-0}"
        return 0
    fi

    targets=
    for p in AGENTS.md CLAUDE.md docs .ai .github; do
        [ -e "$p" ] && targets="$targets $p"
    done
    if [ -d apps ]; then
        app_docs=$(find apps -maxdepth 2 -type d -name docs 2>/dev/null | sort)
        for d in $app_docs; do
            targets="$targets $d"
        done
    fi

    : > "$tmp/marker_hits"
    if [ -n "$targets" ]; then
        # Exclude kit-owned docs/prompts that cite the marker syntax in backticks,
        # and strip inline code spans before scanning for real HTML comment placeholders.
        find $targets \
            \( -path '.ai/bin' -o -path '.ai/prompts' -o -name .git -o -name node_modules \
               -o -name vendor -o -name bin -o -name obj -o -name .next -o -name dist \
               -o -name build \) -prune -o \
            -type f -print 2>/dev/null | sort |
            awk '
                {
                    file = $0
                    n = 0
                    while ((getline line < file) > 0) {
                        n++
                        orig = line
                        gsub(/`[^`]*`/, "", line)
                        if (index(line, "<!-- bootstrap:") > 0) {
                            print file ":" n ":" orig
                        }
                    }
                    close(file)
                }' > "$tmp/marker_hits"
    fi

    if [ ! -s "$tmp/marker_hits" ]; then
        pass 'no bootstrap placeholders remain'
    else
        sed 's/^/      /' "$tmp/marker_hits"
        fail "bootstrap placeholders remain in Phase $phase"
    fi
}

check_trace() {
    find . \
        \( -name .git -o -name docs -o -name .ai -o -name .claude -o -name .cursor \
           -o -name .agents -o -name .windsurf -o -name .kiro -o -name .github \
           -o -name node_modules -o -name vendor -o -name bin -o -name obj \
           -o -name .next -o -name dist -o -name build -o -name .venv \
           -o -name coverage -o -name storage -o -name .turbo -o -name .nuxt \) -prune -o \
        -type f \( -path '*/tests/*' -o -path '*/test/*' -o -path '*/__tests__/*' \
           -o -path '*/e2e/*' -o -path '*/features/*' -o -path '*.Tests/*' \
           -o -name '*.test.*' -o -name '*.spec.*' -o -name '*Test.php' \
           -o -name '*Tests.cs' -o -name '*.feature' \) -print 2>/dev/null |
        awk '
            {
                file = $0
                while ((getline s < file) > 0) {
                    while (match(s, /[0-9][0-9][0-9][0-9]\.R[0-9]+/)) {
                        print substr(s, RSTART, RLENGTH)
                        s = substr(s, RSTART + RLENGTH)
                    }
                }
                close(file)
            }' | sort -u > "$tmp/tags"

    spec_roots=
    [ -d docs ] && spec_roots="$spec_roots docs"
    [ -d apps ] && spec_roots="$spec_roots apps"
    : > "$tmp/specs"
    if [ -n "$spec_roots" ]; then
        find $spec_roots -type f -path '*/specs/[0-9][0-9][0-9][0-9]-*/spec.md' 2>/dev/null | sort > "$tmp/specs"
    fi

    specs=0
    missing=0
    while IFS= read -r spec; do
        status=$(awk '/^- \*\*Status:\*\*/ { sub(/<!--.*-->/, ""); print; exit }' "$spec")
        case $status in *Implemented*) ;; *) continue ;; esac
        specs=$((specs + 1))
        num=$(basename "$(dirname "$spec")" | cut -c1-4)
        awk '
            /^### R[0-9]+($|[^0-9])/ {
                id = $2
                sub(/[^0-9]*$/, "", id)
                if (id ~ /^R[0-9]+$/) test_req[id] = 1
                next
            }
            /^\|[ \t]*R[0-9]+[ \t]*\|/ {
                n = split($0, cols, "|")
                id = cols[2]
                gsub(/^[ \t]+|[ \t]+$/, "", id)
                how = (n >= 5 ? cols[5] : "")
                if (tolower(how) ~ /manual/ || how ~ /docs\/reports\// || how ~ /docs\/audit\//) {
                    ext_req[id] = 1
                } else {
                    test_req[id] = 1
                }
            }
            END {
                for (id in test_req) print "T\t" id
                for (id in ext_req) if (!(id in test_req)) print "E\t" id
            }' "$spec" | sort > "$tmp/spec_ids"

        while IFS="$(printf '\t')" read -r kind id; do
            [ -n "$id" ] || continue
            if [ "$kind" = E ]; then
                if ! grep -qxF "$num.$id" "$tmp/tags"; then
                    note "trace: $num.$id ($spec) verified outside the test suite"
                fi
            elif ! grep -qxF "$num.$id" "$tmp/tags"; then
                fail "trace: $num.$id ($spec) is cited by no test"
                missing=$((missing + 1))
            fi
        done < "$tmp/spec_ids"
    done < "$tmp/specs"

    if [ "$missing" -eq 0 ]; then
        pass "every requirement of $specs Implemented spec(s) is cited by a test"
    fi
}

check_budgets() {
    if [ -f AGENTS.md ]; then
        size=$(wc -c < AGENTS.md | tr -d ' ')
        if [ "$size" -le 32768 ]; then
            pass "AGENTS.md is $size bytes, within Codex's 32 KiB"
        else
            fail "AGENTS.md is $size bytes; Codex reads at most 32 KiB of project instructions by default"
        fi
    else
        fail 'AGENTS.md is missing'
    fi
    ag_count=0
    ag_bad=0
    for f in .agents/rules/*.md; do
        [ -f "$f" ] || continue
        ag_count=$((ag_count + 1))
        size=$(wc -c < "$f" | tr -d ' ')
        if [ "$size" -gt 24000 ]; then
            fail "$f is $size bytes; Antigravity truncates rule files over 24,000 bytes"
            ag_bad=$((ag_bad + 1))
        fi
    done
    if [ "$ag_count" -gt 0 ] && [ "$ag_bad" -eq 0 ]; then
        pass "all $ag_count Antigravity rule file(s) within 24,000 bytes"
    fi
}

check_incoming() {
    found=$(find . \( -name .git -o -name node_modules -o -name vendor \) -prune -o \
        -type f -name '*.specforge-incoming' -print 2>/dev/null | sed 's|^\./||' | sort)
    if [ -z "$found" ]; then
        pass 'no kit file awaits reconciliation'
        return 0
    fi
    printf '%s\n' "$found" | while IFS= read -r f; do
        note "$f: the kit's version of ${f%.specforge-incoming} — merge what you want, then delete it"
    done
}

main() {
    case ${1-} in
        '') ;;
        -h | --help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'usage: .ai/bin/check\n' >&2; exit 2 ;;
    esac

    root=$(cd "$(dirname "$0")/../.." && pwd) || exit 2
    cd "$root" || exit 2

    tmp=$(mktemp -d "${TMPDIR:-/tmp}/check.XXXXXX") || { fail 'cannot create a temporary directory'; exit 1; }
    trap 'rm -rf "$tmp"' EXIT
    trap 'rm -rf "$tmp"; exit 130' INT
    trap 'rm -rf "$tmp"; exit 143' TERM

    check_sync
    check_markers
    check_trace
    check_budgets
    check_incoming

    if [ "$failures" -gt 0 ]; then
        printf 'check: %d failed\n' "$failures"
        exit 1
    fi
    printf 'check: every rule holds\n'
}

main "$@"
